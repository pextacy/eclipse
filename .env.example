# ── Eclipse environment (placeholders only — never commit real secrets) ──
# Copy to `.env` and fill in. `.env` is git-ignored (CLAUDE.md §2.7).

# ── Network (Coston2) ──
COSTON2_RPC=https://coston2-api.flare.network/ext/C/rpc
CHAIN_ID=114
EXPLORER_URL=https://coston2-explorer.flare.network

# ── Flare protocol roots (only the registry is hardcoded — everything else is resolved) ──
FLARE_CONTRACT_REGISTRY=0xaD67FE66660Fb8dFE9d6b1b4240d8650e30F6019
XRP_USD_FEED_ID=0x015852502f55534400000000000000000000000000

# ── Settlement parameters ──
BAND_BPS=50                 # ±0.5% fairness band vs FTSO XRP/USD
BATCH_INTERVAL_SECONDS=30

# ── Token / FAssets addresses ──
# USDT0 quote token (ERC-20 from the Coston2 faucet). Required by `deploy`.
USDT0_ADDRESS=
# Optional override: the FXRP AssetManager. If unset, the resolver walks the
# registry's AssetManagerController and picks the manager whose fAsset is FXRP.
ASSET_MANAGER_ADDRESS=

# ── Deployed Eclipse contracts (filled after `deploy` — see deployments/) ──
ECLIPSE_REGISTRY_ADDRESS=
ECLIPSE_SETTLEMENT_ADDRESS=

# ── Keys (LOCAL ONLY — never commit) ──
# Deployer / relay funding key. Fund from the Coston2 faucet (C2FLR + FXRP + USDT0).
DEPLOYER_PRIVATE_KEY=
# Second demo desk key (for the two-sided demo batch).
DEMO_DESK_B_PRIVATE_KEY=

# ── TEE / engine ──
# In local dev the engine signs with a dev key registered via EclipseRegistry.
# In the deployed demo this is replaced by the attested FCC extension signer (Phase 3).
ENGINE_SIGNER_PRIVATE_KEY=
# Sealed-box keypair the engine publishes so traders can encrypt orders to it.
ENGINE_SEALED_PUBLIC_KEY=
ENGINE_SEALED_SECRET_KEY=

# Whitelisted reproducible-build code-hash for the engine (Phase 3).
ENGINE_CODE_HASH=
# The attested engine signer ADDRESS to whitelist via register:codehash.
ENGINE_SIGNER_ADDRESS=

# ── One-off script inputs ──
# transfer:fxrp — recipient + human-readable amount (default 1).
TO_ADDRESS=
AMOUNT=1
# Relay's gas-paying key (no custody / no settlement authority).
RELAY_PRIVATE_KEY=

# ── Relay ──
RELAY_PORT=8787
RELAY_URL=http://localhost:8787
# The engine endpoint the relay forwards ciphertext to (never plaintext).
ENGINE_URL=http://localhost:8899

# ── Etherscan-style verification (Coston2 uses a Blockscout instance) ──
VERIFIER_URL=https://coston2-explorer.flare.network/api
