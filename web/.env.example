# ── Eclipse web (Next.js) — client env (copy to .env.local) ──
# Only NEXT_PUBLIC_* vars are exposed to the browser. Fill these from
# deployments/coston2.json after `deploy`. Left blank, the app renders a clean
# "not configured" state.

# Deployed Eclipse contracts on Coston2.
NEXT_PUBLIC_ECLIPSE_SETTLEMENT=
NEXT_PUBLIC_ECLIPSE_REGISTRY=

# Registry-resolved token addresses (from the deploy output).
NEXT_PUBLIC_FXRP=
NEXT_PUBLIC_USDT0=

# Relay endpoint the trader console submits sealed orders to.
NEXT_PUBLIC_RELAY_URL=http://localhost:8787
